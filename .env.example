# Copy to .env.local for Next.js; copy to .dev.vars for the Workers preview.
# Never commit real values. APP_ORIGIN must match the browser origin exactly.
APP_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy JWT service-role keys are also supported during migration.
SUPABASE_SERVICE_ROLE_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ADMIN_DISCORD_ID=
DISCORD_ADMIN_WEBHOOK_URL=
# Private Supabase Storage bucket for Vercel. Sites uses its FILES R2 binding.
ASSET_BUCKET=furever-assets
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
